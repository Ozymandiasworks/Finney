{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:finney:a1:stock-startup:v2:dispatch-input",
  "description": "Trusted operational approval, independently hash-pinned outside the delivery. Version 1 is historical and rejected for new runs. No approval is generated by this schema.",
  "type": "object",
  "properties": {
    "version": {
      "const": 2
    },
    "stage": {
      "const": "II"
    },
    "authorized": {
      "const": true
    },
    "ownerApproval": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "runId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "caseId": {
      "const": "S02-REOPEN"
    },
    "network": {
      "const": "xec-regtest"
    },
    "profile": {
      "const": "client-b"
    },
    "validFrom": {
      "type": "string",
      "maxLength": 64
    },
    "expires": {
      "type": "string",
      "maxLength": 64
    },
    "caseMatrixSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "packageManifest": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "fixtureManifest": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "observerReadiness": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "scope": {
      "const": "FIRST_FEASIBILITY"
    },
    "packageSource": {
      "const": "a0e5890e612c81fda4d2698f78dbe4b81fba3e0d"
    },
    "packageSourceRoot": {
      "const": "C:\\FinneyA1Lab\\source"
    },
    "requirementHash": {
      "const": "ec6524ebdc4be39279ba356e23020a8d7e45d0d06dcad878c48bb8cbf40a3fb6"
    },
    "toolingCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "deliveryId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "toolingRoot": {
      "type": "string",
      "pattern": "^C:\\\\FinneyA1Lab\\\\evidence\\\\stock-tooling-v2-[a-f0-9]{32}\\\\tooling$"
    },
    "toolingManifest": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
